# 이 파일을 .env 로 복사해서 쓰세요. .env 는 커밋되지 않습니다.

# --- 서버 ---
# Tailscale 사설망에서 워치가 붙을 수 있게 0.0.0.0 으로 둡니다.
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8765

# 워치 앱이 Authorization: Bearer <토큰> 으로 보낼 값.
# 만들기:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
BRIDGE_TOKEN=

# --- 세션 드라이버 ---
# sdk            : Agent SDK. 승인 감지가 정확함 (기본값)
# remote-control : claude --remote-control 을 pty 로 실행. 공식 앱과 세션 동기화됨 (실험적)
BRIDGE_DRIVER=sdk

# 새 세션에서 고를 수 있는 프로젝트 폴더. 비우면 홈 아래 git 저장소를 자동으로 찾습니다.
# BRIDGE_PROJECTS=$HOME/myproject,$HOME/another

# 세션 하나가 보관하는 로그 줄 수 상한
BRIDGE_MAX_LOG=500

# --- 맥 잠자기 방지 ---
# 맥이 잠들면 세션이 끊기고 워치가 브리지에 닿지도 못합니다. caffeinate 로 막습니다.
# sessions : 살아 있는 세션이 있는 동안만 (기본)
# always   : 브리지가 떠 있는 내내 — 워치로 언제든 새 세션을 만들려면 이쪽
# off      : 쓰지 않음
# 주의: 배터리로 돌면서 뚜껑을 닫으면 macOS 는 어떤 설정으로도 못 막습니다.
BRIDGE_KEEP_AWAKE=sessions

# --- APNs (푸시) ---
# 비워 두면 푸시는 그냥 건너뜁니다. 나머지 기능은 전부 동작합니다.
# .p8 파일은 저장소 밖에 두세요. 절대 커밋 금지.
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=__TEAM_ID__
APNS_BUNDLE_ID=__BUNDLE_ID__
# sandbox 또는 production
APNS_ENV=sandbox
